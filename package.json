{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "proxy": "node server/proxy.mjs",
    "proxy:oficial": "TSE_MODE=oficial node server/proxy.mjs",
    "proxy:sim": "TSE_MODE=sim node server/proxy.mjs",
    "start": "NODE_ENV=production HOST=0.0.0.0 PORT=${PORT:-3000} TSE_MODE=${TSE_MODE:-oficial} node server/proxy.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
