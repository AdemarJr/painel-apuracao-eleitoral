# Em desenvolvimento o Vite encaminha /results → http://127.0.0.1:8787
# Suba o proxy: pnpm proxy
VITE_ELECTION_RESULTS_PATH=/results

# Opcional: falar direto com o proxy (em vez do proxy do Vite)
# VITE_ELECTION_API_BASE_URL=http://127.0.0.1:8787

# Forçar dados sintéticos no frontend:
# VITE_ELECTION_USE_DEMO=true
